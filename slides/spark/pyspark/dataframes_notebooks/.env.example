# Settings for 04_dataframes_with_claude.py
#
# 1. Copy this file to .env in this same folder:   cp .env.example .env
# 2. Put your own API key below (get one at https://platform.claude.com).
# 3. Never commit .env: it is listed in the repository's .gitignore.

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model to use (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: how much the model thinks before answering: low | medium | high
# "low" is fast and cheap, and enough for labeling short reviews.
LLM_EFFORT=low
