# ─────────────────────────────────────────────────────────────────────────────
# .env — PySpark + Claude LLM Integration
#
# HOW TO USE:
#   1. Copy this file to your project root:   cp .env.example .env
#   2. Fill in your values below
#   3. NEVER commit .env to git — add it to .gitignore
#
# The notebooks load this file automatically with:
#   from dotenv import load_dotenv
#   load_dotenv()
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Model selection ───────────────────────────────────────────────────────────
# Available: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Token limits ──────────────────────────────────────────────────────────────
# Program 1 (short classification):   16–64
# Program 2 (JSON multi-field):       256–512
# Program 3 (batched JSON array):     512–1024
LLM_MAX_TOKENS=300

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Check your tier at: docs.anthropic.com/en/api/rate-limits
# Free / Tier 1: ~50 RPM   |   Tier 2: ~1000 RPM
LLM_RATE_LIMIT_RPM=50

# ── Batching (Program 3) ──────────────────────────────────────────────────────
LLM_BATCH_SIZE=5

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_PARTITIONS=4
